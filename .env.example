# Copy to `.env` for local Docker Compose overrides.
# Vite vars are baked in at image build time.

VITE_APP_NAME=FitLog
VITE_DEFAULT_REST_SECONDS=90

# Host port mapping
FITLOG_PORT=8080

# Future sync / API (optional, unused in local-only MVP)
FITLOG_API_BASE_URL=
FITLOG_PUBLIC_ORIGIN=http://localhost:8080
